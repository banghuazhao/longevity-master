    "First Steps" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一步"
          }
        }
      }
    },
    "First check-in" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次打卡"
          }
        }
      }
    },
    "Fitness Fanatic" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健身狂热者"
          }
        }
      }
    },
    "Fix your wake-up time, weekends included, and get outside within an hour of waking." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定起床时间（周末也一样），起床后一小时内到户外去。"
          }
        }
      }
    },
    "Focus for next week" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下周重点"
          }
        }
      }
    },
    "Focus for the rest of the week" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本周剩余时间的重点"
          }
        }
      }
    },
    "Focus on daily check-ins rather than perfect performance" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于每日打卡而不是完美表现"
          }
        }
      }
    },
    "Focus on habits with 4-5 star anti-aging ratings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于具有 4-5 星抗衰老评分的习惯"
          }
        }
      }
    },
    "Focus on habits with higher anti-aging ratings for better scores" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于具有更高抗衰老评分的习惯以获得更好的分数"
          }
        }
      }
    },
    "Follow bedtime routine" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遵循睡前例程"
          }
        }
      }
    },
    "Food" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食物"
          }
        }
      }
    },
    "Four weeks to build a simple, lasting strength habit with moves you can do at home. Muscle protects your joints, bones and blood sugar as you age — and it is never too late to build it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用四周时间，靠在家就能做的动作养成简单而持久的力量训练习惯。随着年龄增长，肌肉保护着你的关节、骨骼和血糖——而且什么时候开始都不晚。"
          }
        }
      }
    },
    "Free on the\nApp Store" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store\n免费下载"
