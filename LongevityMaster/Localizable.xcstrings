            "value" : "抗衰库"
          }
        }
      }
    },
    "General wellness information, not medical advice. Check with your doctor before starting a new exercise or diet program, especially if you have a health condition." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上为一般健康信息，不构成医疗建议。开始新的运动或饮食计划前，请先咨询医生，尤其是有健康问题时。"
          }
        }
      }
    },
    "Get Started" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始使用"
          }
        }
      }
