      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "500-599 分"
          }
        }
      }
    },
    "5–10 minutes of skipping. Cardio that also loads your bones." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳绳 5–10 分钟。既是有氧运动，又能给骨骼适当负荷。"
          }
        }
      }
    },
