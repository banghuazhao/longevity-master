            "state" : "translated",
            "value" : "增加到 3 组，组间休息 60–90 秒。"
          }
        }
      }
    },
    "Add beans or lentils to at least four meals this week." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本周至少有四餐加入豆类或扁豆。"
