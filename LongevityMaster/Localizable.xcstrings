    "You kept to the plan almost every day. These habits are part of your routine now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你几乎每天都按计划完成。这些习惯已经成为你日常的一部分。"
          }
        }
      }
    },
    "You saw it through to the end." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你坚持到了最后。"
          }
        }
      }
    },
    "You saw it through to the end. Run it again and see how much further you get." : {
      "localizations" : {
