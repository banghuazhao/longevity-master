    "Me" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我"
          }
        }
      }
    },
    "Measure at home at the same time of day. High blood pressure is the leading preventable risk for heart disease and stroke." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天同一时间在家测量。高血压是心脏病和中风最主要的可预防风险因素。"
          }
        }
      }
    },
    "Meditate" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冥想"
          }
        }
      }
    },
    "Mediterranean Month" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地中海饮食月"
          }
        }
      }
    },
    "Men who could do more than 40 push-ups had 96% fewer cardiovascular events over 10 years than those who managed fewer than 10." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能做 40 个以上俯卧撑的男性，10 年内心血管事件比做不到 10 个的人少 96%。"
          }
        }
      }
    },
    "Mental Health" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
