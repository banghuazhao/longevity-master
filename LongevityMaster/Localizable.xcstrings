          "stringUnit" : {
            "state" : "translated",
            "value" : "心理健康大师"
          }
        }
      }
    },
    "Middle-aged and older adults who could not stand on one leg for 10 seconds had an 84% higher risk of death over the next 7 years." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法单腿站立 10 秒的中老年人，在之后 7 年的死亡风险高出 84%。"
          }
        }
