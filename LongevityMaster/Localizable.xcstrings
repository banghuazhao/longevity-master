            "value" : "高级+"
          }
        }
      }
    },
    "After being completed on %lld day, the habit will not show up again this month." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %lld 天完成后，该习惯本月将不再显示。"
          }
        }
      }
    },
    "After being completed on %lld day, the habit will not show up again this week." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %lld 天完成后，该习惯本周将不再显示。"
