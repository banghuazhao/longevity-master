            "value" : "各习惯完成情况"
          }
        }
      }
    },
    "How regular people's sleep was predicted their mortality risk more strongly than how long they slept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠是否规律比睡了多久更能预测死亡风险。"
