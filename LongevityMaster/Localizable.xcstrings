      }
    },
    "Add to Favorites" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加到收藏"
          }
        }
      }
    },
    "Add vigorous bursts — take the stairs fast and walk uphill briskly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入高强度爆发——快速爬楼梯、快步上坡。"
          }
        }
      }
    },
    "Advanced" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级"
          }
        }
      }
